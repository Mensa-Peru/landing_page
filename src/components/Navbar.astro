---
import logoMensa from "../assets/images/logo-mensa-peru.png"
---

<nav class="navbar">
  <div class="overlay"></div>

  <div class="container">
    <div class="navbar-logo">
      <img src={logoMensa.src} alt="Logo de Mensa Perú" class="logo">
      <span class="org-name">Mensa Perú</span>
    </div>

    <div class="navbar-toggle">
      <button class="toggle-button" type="button" title="Abrir menú">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>

    <div class="navbar-content">
      <div class="theme-toggle">
        <button class="dark-mode-toggle" type="button" title="Cambiar tema">
          <i class="fas fa-sun active"></i>
          <i class="fas fa-moon"></i>
        </button>
        <button class="toggle-button" type="button" title="Cerrar menú">
          <i class="fa-solid fa-times"></i>
        </button>
      </div>

      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <span class="dropdown-toggle" role="button">
            Sobre Nosotros
            <i class="dropdown-icon fa-solid fa-chevron-down"></i>
          </span>
          <ul class="dropdown-menu">
            <li class="nav-item">
              <a class="nav-link" href="/#who-we-are">Nosotros</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/#our-mission">Misión</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/consejo-directivo">Directiva</a>
            </li>
          </ul>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="/#what-we-offer">¿Qué ofrecemos?</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/#join-us">Únete</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/ofertas-empleo">Empleos</a>
        </li>
      </ul>
    </div>

    <div class="theme-toggle">
      <button class="dark-mode-toggle" type="button" title="Cambiar tema">
        <i class="fas fa-sun active"></i>
        <i class="fas fa-moon"></i>
      </button>
    </div>
  </div>
</nav>
